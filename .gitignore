# Model weights, never committed. The evaluator fetches them with
# download_model.sh. Rule 2 of the submission template asks for both
# *.gguf and model/ to be ignored; the template itself also commits
# model/.gitkeep so the directory exists on clone. Both hold at once,
# because .gitignore does not untrack a file that is already tracked.
model/
model/*.gguf
model/*.bin
model/*.safetensors
*.gguf
out/
__pycache__/
.venv/

# rendered video output: published to YouTube, not committed
video/*.mp4
video/*.srt
video/*.ass
video/frames/

# internal engineering notes, not for publication
internal/

# video production tooling: the demo lives on YouTube, not in the submission
video/
